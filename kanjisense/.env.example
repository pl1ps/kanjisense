# Copy this file to ".env" and fill in real values. The real .env is gitignored.

# Google Gemini API key (for OCR + reasoning) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 "Web application" Client ID (for Sign in with Google)
# https://console.cloud.google.com/apis/credentials
# Add your dev + deployed origins to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
